<Page x:Class="LocalSeek.App.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="using:LocalSeek.App.Views"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
  </Page.KeyboardAccelerators>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <NavigationView x:Name="Navigation"
                    PaneDisplayMode="Top"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="搜尋" Tag="Search" IsSelected="True">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Find" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="診斷" Tag="Diagnostics">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="ReportHacked" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="設定" Tag="Settings">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Setting" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ItemsControl x:Name="NotificationList" Margin="12,8,12,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <InfoBar IsOpen="True" Severity="Warning" Message="{x:Bind}" Margin="0,0,0,4" CloseButtonClick="OnNotificationClosed" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <views:SearchView x:Name="SearchPage" Grid.Row="1" />
        <views:DiagnosticsView x:Name="DiagnosticsPage" Grid.Row="1" Visibility="Collapsed" />
        <views:SettingsView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" />
      </Grid>
    </NavigationView>

    <Border Grid.Row="1"
            Padding="12,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
        <ProgressRing x:Name="BusyRing" Grid.Column="1" Width="16" Height="16" IsActive="False" />
        <TextBlock x:Name="IndexSummaryText" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Name="PauseButton" Grid.Column="3" Padding="10,2" />
      </Grid>
    </Border>
  </Grid>
</Page>
