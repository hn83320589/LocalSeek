<UserControl x:Class="LocalSeek.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Padding="12" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="根資料夾" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <ListView x:Name="RootList" SelectionMode="Single" MinHeight="80" MaxHeight="240"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid>
              <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
              <Button Content="移除" HorizontalAlignment="Right" Tag="{x:Bind}" Click="OnRemoveRoot" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="NewRootBox" PlaceholderText="資料夾完整路徑，例如 D:\客戶資料" TextChanged="OnNewRootChanged" />
        <Button Grid.Column="1" Content="瀏覽…" Click="OnBrowse" />
        <Button x:Name="AddRootButton" Grid.Column="2" Content="加入" />
      </Grid>

      <TextBlock Text="排除規則（每行一個 glob；相對於根資料夾，* 不跨資料夾、** 任意深度、? 單一字元、以 / 結尾只比對資料夾）"
                 TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}" />
      <TextBox x:Name="ExcludeBox" AcceptsReturn="True" MinHeight="100" FontFamily="Consolas" TextChanged="OnExcludeChanged" />

      <NumberBox x:Name="MaxSizeBox" Header="單一檔案大小上限（MB）" Minimum="1" SpinButtonPlacementMode="Inline" ValueChanged="OnMaxSizeChanged" HorizontalAlignment="Left" Width="260" />
      <NumberBox x:Name="PeriodicBox" Header="無法監看時的週期掃描間隔（分鐘）" Minimum="1" SpinButtonPlacementMode="Inline" ValueChanged="OnPeriodicChanged" HorizontalAlignment="Left" Width="260" />
      <ToggleSwitch x:Name="HiddenSwitch" Header="略過隱藏與系統檔案" Toggled="OnHiddenToggled" />
      <ToggleSwitch x:Name="LinksSwitch" Header="跟隨接合點與符號連結（會自動避開迴圈）" Toggled="OnLinksToggled" />

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="SaveButton" Content="儲存並重新索引" Style="{ThemeResource AccentButtonStyle}" />
        <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
