<UserControl x:Class="LocalSeek.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalSeek.App.ViewModels">
  <Grid Padding="12" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ScrollViewer>
      <StackPanel Spacing="12">
        <TextBlock Text="索引統計" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <ItemsControl x:Name="StatisticsList" />

        <TextBlock Text="開啟索引時的檢查" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <ItemsControl x:Name="IssueList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="依原因統計（點選可篩選）" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        <ListView x:Name="SummaryList" SelectionMode="Single" SelectionChanged="OnSummarySelectionChanged">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:DiagnosticKindCount">
              <Grid>
                <TextBlock Text="{x:Bind Name}" />
                <TextBlock Text="{x:Bind Count}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="顯示全部" Click="OnShowAll" />
          <Button x:Name="RefreshButton" Content="重新整理" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Column="1" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="ListTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <ListView x:Name="EntryList" Grid.Row="1" SelectionMode="None">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:DiagnosticItem">
            <StackPanel Padding="0,6">
              <TextBlock Text="{x:Bind Path}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
              <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="{x:Bind Kind}" />
                <Run Text="｜" />
                <Run Text="{x:Bind Message}" />
                <Run Text="｜" />
                <Run Text="{x:Bind Time}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</UserControl>
